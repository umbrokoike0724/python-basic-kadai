      "source": [
        "import numpy as np\n",
        "\n",
        "# 行列Aを定義\n",
        "A = np.array([[0, 1],\n",
        "              [2, 3],\n",
        "              [4, 5]])\n",
        "\n",
        "# 行列Bを定義\n",
        "B = np.array([[0, 1, 2, 3],\n",
        "              [4, 5, 6, 7]])\n",
        "\n",
        "# 行列Aと行列Bの積を計算\n",
        "C = np.dot(A, B)\n",
        "\n",
        "# 計算結果を表示\n",
        "print(C)\n",
        "\n",
        "# 行列Cの要素の最大値を表示\n",
        "print(np.max(C))"
      ]
    }
  ]
